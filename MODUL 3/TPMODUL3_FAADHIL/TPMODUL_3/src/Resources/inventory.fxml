<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="Controller.InventoryController">
    <top>
        <HBox spacing="10" alignment="CENTER">
            <Label text="Inventory Management" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="albumTable">
            <columns>
                <TableColumn text="Album Name" fx:id="colAlbumName"/>
                <TableColumn text="Artist" fx:id="colArtist"/>
                <TableColumn text="Total" fx:id="colTotal"/>
                <TableColumn text="Available" fx:id="colAvailable"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="10" alignment="CENTER" style="-fx-padding: 10;">
            <HBox spacing="10">
                <TextField fx:id="txtAlbumName" promptText="Album Name"/>
                <TextField fx:id="txtArtist" promptText="Artist"/>
                <TextField fx:id="txtTotal" promptText="Total"/>
                <TextField fx:id="txtAvailable" promptText="Available"/>
            </HBox>
            <HBox spacing="10">
                <Button text="Tambah" onAction="#onAddButtonClick"/>
                <Button text="Hapus" onAction="#onDeleteButtonClick"/>
                <Button text="Update" onAction="#onUpdateButtonClick"/>
                <Button text="Rent Selected"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>